# ==========================================
# UNITY PROJECT .gitignore (Production Ready)
# Place at root of Unity project
# ==========================================

# =========================
# UNITY GENERATED
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Bb]ee/
# Recordings can get excessive in size
/[Rr]ecordings/
il2cpp_cache/
ShaderCache/
BuildReports/
ExportedObj/
/[Aa]ssets/GeneratedLocalRepo/
# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# =========================
# OS FILES
# =========================
.DS_Store
Thumbs.db
.utmp/

# =========================
# IDE
# =========================

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.pidb.meta
*.booproj
*.svd
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# Rider / JetBrains
.idea/
.consulo/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# =========================
# LOGS
# =========================
*.log
mono_crash.*
sysinfo.txt

# =========================
# BUILD OUTPUT
# =========================
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta

# Gradle
.gradle/

# Xcode
DerivedData/

# TestRunner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# =========================
# ADDRESSABLES
# =========================
# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*


# =========================
# VISUAL SCRIPTING
# =========================
Assets/Unity.VisualScripting.Generated/

# =========================
# FIREBASE
# =========================
/[Aa]ssets/Firebase/ 

# External Dependency Manager
Assets/ExternalDependencyManager/

# Firebase iOS/tvOS native libs
Assets/Plugins/iOS/Firebase/libFirebaseCppApp.a
Assets/Plugins/tvOS/Firebase/libFirebaseCppApp.a

# Crashlytics
crashlytics-build.properties

# Auto-generated Android Resolver files
Assets/Plugins/Android/mainTemplate.gradle
Assets/Plugins/Android/launcherTemplate.gradle
Assets/Plugins/Android/gradleTemplate.properties
Assets/Plugins/Android/baseProjectTemplate.gradle

# =========================
# LEVEL BUILD (generated by LevelJsonAddressableBuilder / Tools/Level Build)
# =========================
Assets/Project Files/Level System/ActiveLevels/*
!Assets/Project Files/Level System/ActiveLevels/Special
!Assets/Project Files/Level System/ActiveLevels/Special.meta
Assets/Project Files/Level System/ActiveLevels.meta

# =========================
# QUICKNAV (Local Tool Data)
# =========================
Assets/Tools/QuickNav/Data/
Assets/Tools/QuickNav/Data.meta

# =========================
# LOCAL SECRETS (editor-only, per developer)
# =========================
Assets/AutoLocalize/GeminiRequest.Local.cs
Assets/AutoLocalize/GeminiRequest.Local.cs.meta

# =========================
# CACHE / LOCAL GENERATED
# =========================
Assets/FR2_Cache.asset
Assets/FR2_Cache.asset.meta
remote_config_data/

# =========================
# COMPRESSED FILES
# =========================
*.zip
*.rar

# =========================
# UNITY META RULE
# =========================
# Keep meta files unless asset is ignored
!/[Aa]ssets/**/*.meta
# Re-ignore ActiveLevels meta files (overridden by the rule above)
Assets/Project Files/Level System/ActiveLevels/*.meta
!Assets/Project Files/Level System/ActiveLevels/Special.meta
# Re-ignore the per-developer Gemini secret meta (overridden by the meta rule above)
Assets/AutoLocalize/GeminiRequest.Local.cs.meta

# Uncomment this line if you wish to ignore the asset store tools plugin 
# /[Aa]ssets/AssetStoreTools*
*.slnx
.vscode
.cursor/plan/

# =========================
# CLAUDE CODE
# =========================
# Shared team config is committed: .claude/settings.json
# Personal/machine-specific overrides stay local and ignored:
.claude/settings.local.json
.claude/*.local.json

# =========================
# LEVEL CAPTURE EXPORTS (LevelCaptureExporter output)
# =========================
LevelCaptures/

# =========================
# EDITOR-ONLY SPECIAL TEST LEVELS
# =========================
# Each developer keeps their own local set of test levels. The store asset and
# the Test/ levels are auto-created by SpecialLevelsHandler on demand and never
# ship (they live under an Editor/ folder -> Assembly-CSharp-Editor only).
# Ignored after the meta-keep rule above, so their .meta files are dropped too.
/Assets/Project Files/Level System/Editor/SpecialLevels/
/Assets/Project Files/Level System/Editor/SpecialLevels.meta
